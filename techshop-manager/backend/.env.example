# === BASE DE DONNEES ===
DATABASE_URL=postgresql://user:password@localhost:5432/progress_business
REDIS_URL=redis://localhost:6379

# === AUTHENTIFICATION ===
JWT_SECRET=<generer avec: openssl rand -hex 64>
JWT_REFRESH_SECRET=<generer avec: openssl rand -hex 64>
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# === APPLICATION ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DEFAULT_CURRENCY=CDF

# === KPay Mobile Money ===
# Never expose these server-to-server credentials to the frontend.
KPAY_API_KEY=kpay_test_xxxxxxxxxxxxxxxxxxxx
KPAY_SECRET_KEY=<64_caracteres_hexadecimaux>
KPAY_WEBHOOK_SECRET=<secret_hmac_webhook>
KPAY_GATEWAY_SECRET=<secret_hmac_gateway>
KPAY_BASE_URL=https://admin.kpay.site
KPAY_RETURN_URL=https://app.example.com/payments/kpay/return
KPAY_CANCEL_URL=https://app.example.com/payments/kpay/cancel

# === EMAIL TRANSACTIONNEL (Resend API) ===
# Inscription gratuite sur resend.com — 3000 emails/mois
# Dashboard > API Keys > Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sans domaine propre, utiliser: onboarding@resend.dev (test uniquement, envoie à l'email vérifié seulement)
# Avec domaine propre vérifié: noreply@votredomaine.com
MAIL_FROM=Progress Business <onboarding@resend.dev>
MAIL_SUPPORT_TO=support@progressbusiness.cd

# === STOCKAGE FICHIERS ===
STORAGE_ENDPOINT=<url_minio_ou_s3>
STORAGE_BUCKET=progress-business-files
STORAGE_ACCESS_KEY=<access_key>
STORAGE_SECRET_KEY=<secret_key>

# === SYNC OFFLINE ===
OFFLINE_SYNC_INTERVAL_MS=300000

# === EXPORT RAPPORTS ===
EXPORT_MAX_ROWS=50000
EXPORT_TEMP_DIR=/tmp/progress-business-exports
