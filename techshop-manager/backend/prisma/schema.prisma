generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  DIRECTEUR_REGIONAL
  GERANT
  AGENT
  FORMATEUR
  CLIENT
}

enum StatutClient {
  EN_COURS
  ACTIF
  SUSPENDU
  ARCHIVE
}

enum EtapeOnboarding {
  RECIT
  FORMATION
  FICHE
  ACTIVATION
}

enum StatutEtape {
  EN_ATTENTE
  EN_COURS
  COMPLETE
}

enum ModePaiement {
  CASH
  MPESA
  AIRTEL_MONEY
  VIREMENT
}

enum StatutVente {
  EN_ATTENTE_PAIEMENT
  VALIDE
  RETOURNEE_PARTIELLE
  RETOURNEE
  ANNULEE
}

enum StatutRetour {
  EN_ATTENTE_REMBOURSEMENT
  COMPLETE
  ECHEC_REMBOURSEMENT
}

enum TypeMouvement {
  ENTREE
  SORTIE_VENTE
  TRANSFERT_DEPART
  TRANSFERT_ARRIVEE
  AJUSTEMENT_INVENTAIRE
}

enum StatutTransfert {
  EN_TRANSIT
  RECU
  ANNULE
}

enum StatutExport {
  PENDING
  READY
  ERROR
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
}

enum StatutAlerte {
  ALERTE
  RUPTURE
}

// ── MLM enums ────────────────────────────────────────────────────────────────

enum MembreStatut {
  EN_ATTENTE
  ACTIF
  SUSPENDU
  ARCHIVE
}

enum TransactionType {
  COMMISSION
  PROMOTION
  SALAIRE
  BONUS_RETRAITE
  DEBIT
}

enum BonusStatut {
  EN_ATTENTE
  EN_COURS
  LIVRE
  ANNULE
}

enum RetirementBonusStatut {
  EN_ATTENTE
  PAYE
}

enum CommissionStatut {
  EN_ATTENTE
  VALIDEE
  PAYEE
  ANNULEE
}

enum WithdrawalRequestStatut {
  EN_ATTENTE
  APPROUVE
  REJETE
  PAYE
  ANNULE
}

enum WithdrawalRequestType {
  MOBILE_MONEY
  CASH
}

enum KpayOperationType {
  ONBOARDING_PAYMENT
  SALE_PAYMENT
  SALE_REFUND
  MLM_PAYOUT
  AUTO_PAYOUT
}

enum KpayTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum MlmPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// SITE
// ============================================

model Site {
  id          String   @id @default(uuid())
  nom         String
  ville       String
  adresse     String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gerantId    String?

  utilisateurs    Utilisateur[]
  clients         Client[]
  stockSites      StockSite[]
  ventesSource    Vente[]
  mouvements      MouvementStock[]
  transfertsSource    TransfertStock[] @relation("SiteSource")
  transfertsDest      TransfertStock[] @relation("SiteDestination")
  onboardingEtapes    OnboardingEtape[]

  @@map("sites")
}

// ============================================
// UTILISATEUR
// ============================================

model Utilisateur {
  id                String   @id @default(uuid())
  nom               String
  telephone         String   @unique
  email             String?  @unique
  passwordHash      String
  role              Role
  actif             Boolean  @default(true)
  langue            String   @default("fr")
  derniereConnexion DateTime?
  tentativesConnexion Int    @default(0)
  bloqueJusquA      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  siteId  String?
  site    Site?   @relation(fields: [siteId], references: [id])

  ventesCreees    Vente[]
  clientsCrees    Client[]
  etapesValidees  OnboardingEtape[]
  entreesStock    MouvementStock[]
  transfertsInities TransfertStock[] @relation("TransfertInitiateur")

  @@map("utilisateurs")
}

// ============================================
// CLIENT
// ============================================

model Client {
  id                String         @id @default(uuid())
  prenom            String
  nom               String
  telephone         String         @unique
  email             String?        @unique
  matriculeExterne  String?        @unique
  codeParrain       String?        @unique
  parrainClientId   String?
  statut            StatutClient   @default(EN_COURS)
  notes             String?
  dateActivation    DateTime?
  pinHash           String?
  tentativesPin     Int            @default(0)
  bloqueJusquA      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  siteInscriptionId String
  siteInscription   Site          @relation(fields: [siteInscriptionId], references: [id])

  createdById String
  createdBy   Utilisateur @relation(fields: [createdById], references: [id])

  onboardingEtapes  OnboardingEtape[]
  ventes            Vente[]
  membre            Membre?
  parrainClient     Client?        @relation("ClientParrainage", fields: [parrainClientId], references: [id])
  filleulsParrainage Client[]      @relation("ClientParrainage")

  @@map("clients")
}

// ============================================
// ONBOARDING
// ============================================

model OnboardingEtape {
  id                   String          @id @default(uuid())
  etape                EtapeOnboarding
  statut               StatutEtape     @default(EN_ATTENTE)
  completeeAt          DateTime?
  montant              Decimal?        @db.Decimal(12, 2)
  modePaiement         ModePaiement?
  referenceTransaction String?
  notes                String?
  createdAt            DateTime        @default(now())

  clientId  String
  client    Client      @relation(fields: [clientId], references: [id])

  agentId   String
  agent     Utilisateur @relation(fields: [agentId], references: [id])

  siteId    String
  site      Site        @relation(fields: [siteId], references: [id])

  kpayTransactions KpayTransaction[] @relation("OnboardingEtapeKpayTransactions")

  @@unique([clientId, etape])
  @@map("onboarding_etapes")
}

// ============================================
// PRODUIT
// ============================================

model Produit {
  id          String   @id @default(uuid())
  sku         String   @unique
  nom         String
  description String?
  categorie   String
  prixVente   Decimal  @db.Decimal(12, 2)
  prixAchat   Decimal  @db.Decimal(12, 2)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockSites     StockSite[]
  mouvements     MouvementStock[]
  lignesVente    LigneVente[]
  lignesRetour   LigneRetour[]
  transferts     TransfertStock[]

  @@map("produits")
}

// ============================================
// STOCK SITE
// ============================================

model StockSite {
  id           String       @id @default(uuid())
  quantite     Int          @default(0)
  seuilAlerte  Int          @default(5)
  updatedAt    DateTime     @updatedAt

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  @@unique([produitId, siteId])
  @@map("stock_sites")
}

// ============================================
// MOUVEMENT STOCK
// ============================================

model MouvementStock {
  id             String        @id @default(uuid())
  type           TypeMouvement
  quantite       Int
  quantiteAvant  Int
  quantiteApres  Int
  reference      String?
  createdAt      DateTime      @default(now())

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  agentId String
  agent   Utilisateur @relation(fields: [agentId], references: [id])

  @@map("mouvements_stock")
}

// ============================================
// TRANSFERT STOCK
// ============================================

model TransfertStock {
  id               String          @id @default(uuid())
  quantiteEnvoyee  Int
  quantiteRecue    Int?
  motif            String?
  observations     String?
  statut           StatutTransfert @default(EN_TRANSIT)
  dateExpedition   DateTime        @default(now())
  dateReception    DateTime?
  createdAt        DateTime        @default(now())

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  siteSourceId String
  siteSource   Site   @relation("SiteSource", fields: [siteSourceId], references: [id])

  siteDestinationId String
  siteDestination   Site   @relation("SiteDestination", fields: [siteDestinationId], references: [id])

  initiateurId String
  initiateur   Utilisateur @relation("TransfertInitiateur", fields: [initiateurId], references: [id])

  @@map("transferts_stock")
}

// ============================================
// VENTE
// ============================================

model Vente {
  id                  String      @id @default(uuid())
  numeroVente         String      @unique
  statut              StatutVente @default(VALIDE)
  montantBrut         Decimal     @db.Decimal(12, 2)
  remiseFidelite      Decimal     @default(0) @db.Decimal(12, 2)
  remiseParrainage    Decimal     @default(0) @db.Decimal(12, 2)
  montantNet          Decimal     @db.Decimal(12, 2)
  modePaiement        ModePaiement
  referenceTransaction String?
  montantRecu         Decimal?    @db.Decimal(12, 2)
  monnaieRendue       Decimal?    @db.Decimal(12, 2)
  pointsAttribues     Int         @default(0)
  syncStatus          SyncStatus  @default(SYNCED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  agentId String
  agent   Utilisateur @relation(fields: [agentId], references: [id])

  lignes  LigneVente[]
  retours Retour[]
  kpayTransactions KpayTransaction[] @relation("VenteKpayTransactions")

  @@map("ventes")
}

// ============================================
// LIGNE VENTE
// ============================================

model LigneVente {
  id          String  @id @default(uuid())
  quantite    Int
  prixUnitaire Decimal @db.Decimal(12, 2)
  sousTotal   Decimal @db.Decimal(12, 2)

  venteId   String
  vente     Vente   @relation(fields: [venteId], references: [id])

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  @@map("lignes_vente")
}

// ============================================
// RETOUR
// ============================================

model Retour {
  id                   String   @id @default(uuid())
  statut               StatutRetour @default(COMPLETE)
  numeroAvoir          String?  @unique
  motif                String
  motifDescription     String?
  modeRemboursement    String
  referenceTransaction String?
  montantRembourse     Decimal  @db.Decimal(12, 2)
  stockRemis           Boolean  @default(false)
  agentId              String?
  createdAt            DateTime @default(now())

  venteId String
  vente   Vente  @relation(fields: [venteId], references: [id])

  lignes LigneRetour[]
  kpayTransactions KpayTransaction[] @relation("RetourKpayTransactions")

  @@map("retours")
}

// ============================================
// LIGNE RETOUR
// ============================================

model LigneRetour {
  id       String @id @default(uuid())
  quantite Int

  retourId String
  retour   Retour @relation(fields: [retourId], references: [id])

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  @@map("lignes_retour")
}


// ============================================
// CONFIG GENERALE
// ============================================

model ConfigGenerale {
  id                    String   @id @default(uuid())
  smsApiKey             String?
  smsUsername           String?
  smsSenderId           String?
  matriculeExterneActif Boolean  @default(false)
  matriculeRegex        String?
  dureeSectionHeures    Int      @default(8)
  delaiRetourJours      Int      @default(7)
  fraisRetourPct        Decimal  @default(0) @db.Decimal(5, 2)
  kpayAutoPayoutActif  Boolean  @default(false)
  kpayAutoPayoutProvider String?
  kpayAutoPayoutPhone  String?
  kpayAdminMpesaPhone String?
  kpayAdminAirtelPhone String?
  kpayAdminOrangePhone String?
  updatedAt             DateTime @updatedAt

  @@map("config_generale")
}

// ============================================
// EXPORT JOB
// ============================================

model ExportJob {
  id          String       @id @default(uuid())
  type        String
  format      String
  filtres     Json?
  statut      StatutExport @default(PENDING)
  downloadUrl String?
  errorMsg    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("export_jobs")
}

// ============================================
// SUPPORT
// ============================================

enum TicketType {
  BUG
  SUGGESTION
  QUESTION
  CONFIG
  URGENCE
}

model SupportTicket {
  id            String     @id @default(uuid())
  ticketRef     String     @unique
  nom           String
  email         String
  siteNom       String
  role          String
  type          TicketType
  sujet         String
  description   String     @db.Text
  systemInfo    String?    @db.Text
  hasScreenshot Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@map("support_tickets")
}

// ============================================
// CANDIDATURE AMBASSADEUR (site public)
// ============================================

enum AmbassadeurStatut {
  NOUVELLE
  CONTACTEE
  CONVERTIE
  ANNULEE
}

model AmbassadeurApplication {
  id          String              @id @default(uuid())
  prenom      String
  nom         String
  telephone   String
  email       String?
  ville       String
  siteNom     String?
  codeParrain String?
  motivation  String?
  statut      AmbassadeurStatut   @default(NOUVELLE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([statut])
  @@map("ambassadeur_applications")
}

// ============================================================
// MLM — Plan de carrière à 8 niveaux
// ============================================================

// ── Niveaux de carrière ───────────────────────────────────────
model MlmLevel {
  id                   Int      @id @default(autoincrement())
  ordre                Int      @unique
  nom                  String
  filleulsRequis       Int      @default(4)
  commissionParFilleul Decimal  @db.Decimal(12, 2)
  commissionTotale     Decimal  @db.Decimal(12, 2)
  bonusDescription     String
  salaireMensuel       Decimal  @default(0) @db.Decimal(12, 2)
  salaireActif         Boolean  @default(false)
  isActive             Boolean  @default(true)
  couleur              String
  icone                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  membres        Membre[]
  matrices       Matrix[]
  bonusAttribues BonusAttribue[]
  commissions    Commission[]

  @@map("mlm_levels")
}

// ── Profil MLM de chaque client activé ───────────────────────
model Membre {
  id              String       @id @default(uuid())
  clientId        String       @unique
  matricule       String       @unique
  parrainId       String?
  mlmLevelId      Int          @default(1)
  statut          MembreStatut @default(ACTIF)
  dateActivation  DateTime     @default(now())
  dateInscription DateTime     @default(now())

  client      Client    @relation(fields: [clientId], references: [id])
  level       MlmLevel  @relation(fields: [mlmLevelId], references: [id])
  parrain     Membre?   @relation("ParrainFilleul", fields: [parrainId], references: [id])
  filleuls    Membre[]  @relation("ParrainFilleul")

  portefeuille         Portefeuille?
  matrices             Matrix[]
  promotions           Promotion[]      @relation("MembrePromotion")
  bonusAttribues       BonusAttribue[]
  salairesVerses       SalaireVerse[]
  bonusRetraites       BonusRetraite[]  @relation("MembreBonusRetraite")
  bonusRetraitesDonnes BonusRetraite[]  @relation("FilleulCrownBonusRetraite")
  commissionsRecues    Commission[]     @relation("CommissionBeneficiaire")
  commissionsGenerees  Commission[]     @relation("CommissionFilleul")
  payouts              MlmPayout[]
  withdrawalRequests   WithdrawalRequest[]

  @@map("membres")
}

// ── Matrice de 4 positions par membre et par niveau ──────────
model Matrix {
  id             String    @id @default(uuid())
  membreId       String
  mlmLevelId     Int
  filleulsValides Int      @default(0)
  estComplete    Boolean   @default(false)
  dateComplete   DateTime?
  createdAt      DateTime  @default(now())

  membre    Membre    @relation(fields: [membreId], references: [id])
  level     MlmLevel  @relation(fields: [mlmLevelId], references: [id])
  positions Position[]

  @@unique([membreId, mlmLevelId])
  @@map("matrices")
}

// ── Position dans une matrice (1 à 4) ────────────────────────
model Position {
  id             String    @id @default(uuid())
  matrixId       String
  numeroPosition Int
  filleulId      String?
  estValide      Boolean   @default(false)
  dateValidation DateTime?

  matrix Matrix @relation(fields: [matrixId], references: [id])

  @@unique([matrixId, numeroPosition])
  @@map("positions")
}

// ── Portefeuille USD par membre ───────────────────────────────
model Portefeuille {
  id               String   @id @default(uuid())
  membreId         String   @unique
  soldeDisponible  Decimal  @default(0) @db.Decimal(12, 2)
  soldeReserve     Decimal  @default(0) @db.Decimal(12, 2)
  totalGagne       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  membre       Membre                    @relation(fields: [membreId], references: [id])
  transactions TransactionPortefeuille[]

  @@map("portefeuilles")
}

// ── Journal immuable des transactions USD ─────────────────────
model TransactionPortefeuille {
  id             String          @id @default(uuid())
  portefeuilleId String
  type           TransactionType
  montant        Decimal         @db.Decimal(12, 2)
  description    String
  referenceId    String?
  createdAt      DateTime        @default(now())

  portefeuille Portefeuille @relation(fields: [portefeuilleId], references: [id])

  @@map("transactions_portefeuille")
}

model MlmPayout {
  id          String          @id @default(uuid())
  montant     Decimal         @db.Decimal(12, 2)
  provider    String
  phoneNumber String
  statut      MlmPayoutStatus @default(PENDING)
  failureReason String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  membreId String
  membre   Membre @relation(fields: [membreId], references: [id])
  kpayTransaction KpayTransaction?

  @@index([membreId, statut])
  @@map("mlm_payouts")
}

model KpayTransaction {
  id                       String                @id @default(uuid())
  operationType            KpayOperationType
  status                   KpayTransactionStatus @default(PENDING)
  amount                   Decimal               @db.Decimal(12, 2)
  currency                 String                @default("USD")
  externalId               String                @unique
  kpayPaymentId            String?               @unique
  kpayReference            String?
  provider                 String?
  phoneNumber              String?
  failureReason            String?
  metadata                 Json?
  terminalEventProcessedAt DateTime?
  completedAt              DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  venteId String?
  vente   Vente? @relation("VenteKpayTransactions", fields: [venteId], references: [id])
  onboardingEtapeId String?
  onboardingEtape   OnboardingEtape? @relation("OnboardingEtapeKpayTransactions", fields: [onboardingEtapeId], references: [id])
  retourId String?
  retour   Retour? @relation("RetourKpayTransactions", fields: [retourId], references: [id])
  payoutId String? @unique
  payout   MlmPayout? @relation(fields: [payoutId], references: [id])

  @@index([venteId])
  @@index([onboardingEtapeId])
  @@index([retourId])
  @@map("kpay_transactions")
}

// ── Historique des promotions ─────────────────────────────────
model Promotion {
  id               String   @id @default(uuid())
  membreId         String
  niveauAvantId    Int
  niveauApresId    Int
  commissionVersee Decimal  @db.Decimal(12, 2)
  datePromotion    DateTime @default(now())
  declencheParId   String

  membre Membre @relation("MembrePromotion", fields: [membreId], references: [id])

  @@map("promotions")
}

// ── Bonus physiques attribués ─────────────────────────────────
model BonusAttribue {
  id              String      @id @default(uuid())
  membreId        String
  mlmLevelId      Int
  description     String
  statut          BonusStatut @default(EN_ATTENTE)
  dateAttribution DateTime    @default(now())
  dateLivraison   DateTime?
  notes           String?

  membre Membre   @relation(fields: [membreId], references: [id])
  level  MlmLevel @relation(fields: [mlmLevelId], references: [id])

  @@map("bonus_attribues")
}

// ── Salaires mensuels versés ──────────────────────────────────
model SalaireVerse {
  id            String   @id @default(uuid())
  membreId      String
  montant       Decimal  @db.Decimal(12, 2)
  moisAnnee     String
  dateVersement DateTime @default(now())
  statut        String   @default("VERSE")

  membre Membre @relation(fields: [membreId], references: [id])

  @@unique([membreId, moisAnnee])
  @@map("salaires_verses")
}

// ── Bonus retraite (parrain d'un Crown Ambassadeur) ───────────
model BonusRetraite {
  id             String                @id @default(uuid())
  membreId       String
  filleulCrownId String
  montant        Decimal               @default(50000) @db.Decimal(12, 2)
  statut         RetirementBonusStatut @default(EN_ATTENTE)
  dateVersement  DateTime              @default(now())

  membre       Membre @relation("MembreBonusRetraite", fields: [membreId], references: [id])
  filleulCrown Membre @relation("FilleulCrownBonusRetraite", fields: [filleulCrownId], references: [id])

  @@unique([membreId, filleulCrownId])
  @@map("bonus_retraites")
}

// ── Commissions MLM (Option B : validation admin requise) ─────
model Commission {
  id          String            @id @default(uuid())
  membreId    String
  filleulId   String
  mlmLevelId  Int
  montant     Decimal           @db.Decimal(12, 2)
  statut      CommissionStatut  @default(EN_ATTENTE)
  referenceId String            @unique
  description String
  notes       String?
  valideeAt   DateTime?
  payeeAt     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  membre   Membre   @relation("CommissionBeneficiaire", fields: [membreId], references: [id])
  filleul  Membre   @relation("CommissionFilleul", fields: [filleulId], references: [id])
  level    MlmLevel @relation(fields: [mlmLevelId], references: [id])

  @@index([membreId])
  @@index([statut])
  @@map("commissions")
}

// ── Withdrawal Requests (Demandes de retrait) ─────────────────────
model WithdrawalRequest {
  id                String                   @id @default(uuid())
  membreId          String
  montant           Decimal                  @db.Decimal(12, 2)
  type              WithdrawalRequestType
  provider          String?
  phoneNumber       String?
  statut            WithdrawalRequestStatut  @default(EN_ATTENTE)
  commissionIds     Json
  notes             String?
  rejectReason      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  approvedAt        DateTime?
  approvedById      String?
  paidAt            DateTime?

  membre            Membre                   @relation(fields: [membreId], references: [id])

  @@index([membreId])
  @@index([statut])
  @@map("withdrawal_requests")
}

// ── Catégories de produits (table dédiée, ex-portées par les produits) ──
model Categorie {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())

  @@map("categories")
}

// ── Tokens de réinitialisation mot de passe (remplace otpStore en mémoire) ──
model PasswordResetToken {
  id         String    @id @default(uuid())
  identifier String // téléphone de l'utilisateur ciblé
  otpHash    String // OTP 6 chiffres hashé bcrypt
  resetToken String?   @unique // UUID délivré après vérification OTP
  attempts   Int       @default(0) // max 3 essais OTP
  expiresAt  DateTime // OTP : +10 min puis réutilisé pour le resetToken : +15 min
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier])
  @@map("password_reset_tokens")
}
